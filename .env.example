# ——— Web ———
# Dirección pública y canónica, sin barra final (usa la versión con www).
# La versión sin www redirigirá automáticamente a esta.
NEXT_PUBLIC_SITE_URL=

# ——— Blog: panel de administración en /admin (Sanity) ———
# ID del proyecto en sanity.io/manage (p. ej. "a1b2c3d4").
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Clave secreta del webhook para publicar al momento (inventa una larga).
SANITY_REVALIDATE_SECRET=

# Clave de Sanity con permiso de Editor (sanity.io/manage → API → Tokens), para
# marcar un correo como "enviado" y que no se repita.
# Contraseña para entrar en /admin (mínimo 8 caracteres)
ADMIN_PASSWORD=
# Correo donde llegan los mensajes del formulario de contacto (si no, el de data/site.ts)
CONTACT_TO=
SANITY_WRITE_TOKEN=

# ——— Newsletter (Brevo) ———
BREVO_API_KEY=
# Número de la lista de contactos (Contactos → Listas).
BREVO_LIST_ID=
# (Recomendado) Plantilla de doble confirmación ("confirma tu suscripción").
BREVO_DOI_TEMPLATE_ID=
# Remitente VERIFICADO en Brevo (Remitentes y dominios) desde el que salen
# las entradas del blog y los avisos por correo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Estafeta Gourmet
